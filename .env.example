# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session encryption key — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Super admin credentials (no hardcoded fallback — must be set)
SUPER_ADMIN_EMAIL=admin@yourdomain.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# ─── Optional ─────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=production
